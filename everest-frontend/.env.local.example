# ─── Everest Frontend — Environment Variables ─────────────────────────────────
# Copy this file to .env.local for local development.
# For Vercel production: set these in Vercel dashboard → Project → Settings → Environment Variables.

# ── Backend API URL ───────────────────────────────────────────────────────────
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Production (replace with your Railway or Render backend URL):
# NEXT_PUBLIC_API_URL=https://everest-backend-production.up.railway.app/api
