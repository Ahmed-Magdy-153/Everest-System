# ─── Everest Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env (local) or set these in Railway / Render dashboard.
# Never commit .env to git.

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3001

# ── CORS — comma-separated list of allowed frontend origins ───────────────────
# Local only:
#   CORS_ORIGIN=http://localhost:3000
# Production:
#   CORS_ORIGIN=https://your-app.vercel.app
# Both:
#   CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGIN="http://localhost:3000"
