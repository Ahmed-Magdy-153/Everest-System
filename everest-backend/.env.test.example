# ─── TEST DATABASE — copy this to .env.test and fill in your TEST Supabase project ───
# NEVER point these at the production database.
# Create a free second Supabase project at https://supabase.com and paste its URLs here.

TEST_DATABASE_URL="postgresql://postgres.[TEST-PROJECT-REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
TEST_DIRECT_URL="postgresql://postgres.[TEST-PROJECT-REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# JWT for test route-level tests (any non-empty string works)
JWT_SECRET="test-only-secret-never-use-in-production"
JWT_EXPIRES_IN="1h"
NODE_ENV="test"
